KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094

# Topics
TOPIC_PRICES=crypto.prices
TOPIC_HISTORY=crypto.history
TOPIC_ONCHAIN=crypto.onchain

# Assets à tracker
ASSETS=BTC,ETH,SOL,BNB,XRP

# Binance WebSocket
BINANCE_WS_URL=wss://stream.binance.com:9443/stream

# CoinGecko API (gratuit, pas de clé nécessaire)
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_FETCH_INTERVAL_SEC=60

# Etherscan
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
ETHERSCAN_BASE_URL=https://api.etherscan.io/api
ETHERSCAN_FETCH_INTERVAL_SEC=30

# Kafka Producer settings
KAFKA_ACKS=all
KAFKA_RETRIES=5
KAFKA_LINGER_MS=5
KAFKA_BATCH_SIZE=16384

# Indicateurs
TOPIC_INDICATORS=crypto.indicators

# MinIO / Delta Lake
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
DELTA_LAKE_PATH=s3a://cryptoflow

# TimescaleDB
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=cryptoflow
TIMESCALE_USER=crypto
TIMESCALE_PASSWORD=crypto

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=5

# API (laisser API_KEY vide = pas d'authentification)
API_KEY=
CORS_ORIGINS=*
RATE_LIMIT_PER_MIN=120
CACHE_TTL_SUMMARY=10

# Alertes (RSI précis du job batch, squeeze Bollinger 1h, gros transferts ETH)
ALERT_RSI_OVERBOUGHT=70
ALERT_RSI_OVERSOLD=30
ALERT_SQUEEZE_BANDWIDTH=0.02
ALERT_WHALE_ETH=500
ALERT_COOLDOWN_SEC=900
# Canaux (au moins un pour être notifié ; sinon logs uniquement)
ALERT_SLACK_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Spark streaming : sortie console de debug (désactivée par défaut)
ENABLE_CONSOLE_SINK=false